generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionKind {
  snooker
  egame
}

enum SessionStatus {
  active
  finished
}

enum TableState {
  available
  occupied
  maintenance
}

enum BillStatus {
  unpaid
  paid
}

model Player {
  id            String   @id @default(cuid())
  name          String
  phone         String
  visits        Int      @default(1)
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  bills         Bill[]
  tableAssignments ClubTableAssignment[]
}

model ClubTable {
  id        String        @id @default(cuid())
  name      String
  state     TableState    @default(available)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  assignments ClubTableAssignment[]
}

enum AssignmentState {
  active
  ended
}

model ClubTableAssignment {
  id        String           @id @default(cuid())
  playerId  String
  tableId   String
  state     AssignmentState  @default(active)
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  player    Player    @relation(fields: [playerId], references: [id])
  table     ClubTable @relation(fields: [tableId], references: [id])
}

model Session {
  id          String       @id @default(cuid())
  playerId    String
  kind        SessionKind
  activity    String
  resource    String
  amount      Int
  status      SessionStatus @default(active)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  player        Player       @relation(fields: [playerId], references: [id])
  billLines     BillLine[]
}

model Bill {
  id          String     @id @default(cuid())
  playerId    String
  reference   String     @unique @default(cuid())
  status      BillStatus @default(unpaid)
  description String?
  paidAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  player    Player      @relation(fields: [playerId], references: [id])
  lines     BillLine[]
}

model BillLine {
  id        String   @id @default(cuid())
  billId    String
  sessionId String?
  kind      String
  description String
  amount    Int

  createdAt DateTime @default(now())

  bill     Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  session  Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
}

model MenuItem {
  id        String   @id @default(cuid())
  name      String
  price     Int
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
